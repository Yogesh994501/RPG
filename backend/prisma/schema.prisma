// Prisma Schema for LifeRPG — Full-Stack Gamified Productivity App
// Supports PostgreSQL via DATABASE_URL (production) and SQLite (development)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum SkillTree {
  mind
  body
  craft
  discipline
}

enum Difficulty {
  trivial
  easy
  medium
  hard
  legendary
}

enum Recurrence {
  none
  daily
  weekly
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  displayName    String
  level          Int             @default(1)
  currentXP      Int             @default(0)
  xpToNextLevel  Int             @default(120)
  gold           Int             @default(50)
  currentStreak  Int             @default(0)
  longestStreak  Int             @default(0)
  lastActiveDate String?
  createdAt      DateTime        @default(now())

  // Relational Entities
  quests         Quest[]
  questLogs      QuestLog[]
  inventoryItems InventoryItem[]
  transactions   Transaction[]
  titles         Title[]

  @@map("users")
}

model Quest {
  id          String      @id @default(uuid())
  userId      String
  title       String
  description String      @default("")
  category    SkillTree
  difficulty  Difficulty  @default(medium)
  recurrence  Recurrence  @default(daily)
  isActive    Boolean     @default(true)
  isCompleted Boolean     @default(false)
  completedAt DateTime?
  createdAt   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  questLogs   QuestLog[]

  @@index([userId, isActive])
  @@map("quests")
}

model QuestLog {
  id                 String        @id @default(uuid())
  questId            String?
  userId             String
  completedAt        DateTime      @default(now())
  xpAwarded          Int
  goldAwarded        Int
  streakAtCompletion Int

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest              Quest?        @relation(fields: [questId], references: [id], onDelete: SetNull)
  transactions       Transaction[]

  @@index([userId, completedAt])
  @@map("quest_logs")
}

model ShopItem {
  id          String          @id @default(uuid())
  name        String
  description String
  cost        Int
  effect      String          @default("cosmetic")
  rarity      String          @default("Common")
  icon        String
  bonusStat   String?
  bonusValue  Int             @default(0)

  inventory   InventoryItem[]

  @@map("shop_items")
}

model InventoryItem {
  id         String   @id @default(uuid())
  userId     String
  itemId     String
  quantity   Int      @default(1)
  isEquipped Boolean  @default(false)
  acquiredAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("inventory")
}

model Transaction {
  id                String    @id @default(uuid())
  userId            String
  amount            Int
  reason            String
  relatedQuestLogId String?
  createdAt         DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questLog          QuestLog? @relation(fields: [relatedQuestLogId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("transactions")
}

model Title {
  id         String   @id @default(uuid())
  userId     String
  name       String
  unlockedAt DateTime @default(now())
  criteria   String

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("titles")
}
